# ==============================================================================
# DAGNA (ዳኛ) - Environment Configuration Example
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:5173

# Database (MongoDB Single-Node Replica Set)
MONGODB_URI=mongodb://127.0.0.1:27017/dagna?replicaSet=rs0
MONGODB_TEST_URI=mongodb://127.0.0.1:27017/dagna_test?replicaSet=rs0

# Redis Cache & BullMQ
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets (Generate with `openssl rand -hex 32`)
JWT_ACCESS_SECRET=c29tZS1zdXBlci1zZWNyZXQtYWNjZXNzLXRva2VuLWtleS0zMi1ieXRlcy1sb25nCg==
JWT_REFRESH_SECRET=YW5vdGhlci1zdXBlci1zZWNyZXQtcmVmcmVzaC10b2tlbi1rZXktMzItYnl0ZXM=
CURSOR_SIGNING_KEY=c3VwZXItc2VjcmV0LWN1cnNvci1zaWduaW5nLWtleS1mb3ItZGFnbmE=

# S3 / MinIO Object Storage
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_PROBLEMS=dagna-problems
S3_BUCKET_TESTS=dagna-test-blobs
S3_FORCE_PATH_STYLE=true

# Email Service (Mailpit / SMTP)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Dagna Online Judge <noreply@example.com>"

# Judge Gateway & Agent Configuration
JUDGE_GATEWAY_PORT=4001
JUDGE_GATEWAY_HOST=127.0.0.1
JUDGE_NODE_ID=judge-node-01
JUDGE_NODE_TOKEN=node_token_dev_secret_fencing_token_testing_only
WIREGUARD_INTERFACE_IP=10.100.0.1

# Feature Flags
JUDGING_ENABLED=true
DOUBLE_JUDGE_CONTEST_AC=false
DEBUG_SANDBOX=false
