# ==============================================================================
# DAGNA (ዳኛ) - Environment Configuration Example
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:5173

# Database (MongoDB Replica Set: Atlas M0 or local rs0)
MONGODB_URI=mongodb://127.0.0.1:27017/dagna?replicaSet=rs0
MONGODB_TEST_URI=mongodb://127.0.0.1:27017/dagna_test?replicaSet=rs0

# Redis Cache & BullMQ (Use REDIS_URL for Render / Upstash or REDIS_HOST/PORT/PASSWORD)
REDIS_URL=redis://127.0.0.1:6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets (Generate with `openssl rand -hex 32`)
JWT_ACCESS_SECRET=6da732f22511d54d9d9eb97a5239e08eee9f343f13ce2f75b175ad4aa3e715e1
JWT_REFRESH_SECRET=27f090cbec6e57cd60855bbf7043a46fa44278b620914e08af067a5e206a8020
CURSOR_SIGNING_KEY=1261c347b98ef5d83147a44135271be6

# Chapa Payment Gateway (Ethiopian Birr / Telebirr / CBE Birr)
CHAPA_SECRET_KEY=CHASECK_TEST-sample_test_key_here
CHAPA_PUBLIC_KEY=CHAPUBK_TEST-sample_test_key_here
CHAPA_WEBHOOK_SECRET=sample_webhook_secret_here

# Frontend Configuration (for Vercel / Client)
VITE_API_URL=http://localhost:4000

# S3 / MinIO Object Storage
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_PROBLEMS=dagna-problems
S3_BUCKET_TESTS=dagna-test-blobs
S3_FORCE_PATH_STYLE=true

# Email Service (Mailpit / SMTP)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Dagna Online Judge <noreply@example.com>"

# Judge Gateway & Agent Configuration
JUDGE_GATEWAY_PORT=4001
JUDGE_GATEWAY_HOST=127.0.0.1
JUDGE_NODE_ID=judge-node-01
JUDGE_NODE_TOKEN=node_token_dev_secret_fencing_token_testing_only
WIREGUARD_INTERFACE_IP=10.100.0.1

# Feature Flags
JUDGING_ENABLED=true
DOUBLE_JUDGE_CONTEST_AC=false
DEBUG_SANDBOX=false
