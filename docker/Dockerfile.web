# Multi-stage Dockerfile for Dagna React SPA
FROM node:22-alpine AS builder

WORKDIR /app

COPY package.json tsconfig.json ./
COPY packages/shared/package.json ./packages/shared/
COPY packages/shared/tsconfig.json ./packages/shared/
COPY web/package.json ./web/
COPY web/tsconfig.json ./web/
COPY web/vite.config.ts ./web/

RUN npm install

COPY packages/shared/src ./packages/shared/src
COPY web/src ./web/src
COPY web/index.html ./web/
COPY web/tailwind.config.js ./web/
COPY web/postcss.config.js ./web/

RUN npm run build --workspace=packages/shared && \
    npm run build --workspace=web

# Static web server stage
FROM nginx:1.27-alpine AS runner

COPY --from=builder /app/web/dist /usr/share/nginx/html
COPY nginx/nginx.web.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

HEALTHCHECK --interval=10s --timeout=3s --retries=3 \
  CMD wget --spider http://127.0.0.1/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
