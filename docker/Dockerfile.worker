# Multi-stage Dockerfile for Dagna BullMQ Workers & Scheduler
FROM node:22-alpine AS builder

WORKDIR /app

COPY package.json tsconfig.json ./
COPY packages/shared/package.json ./packages/shared/
COPY packages/shared/tsconfig.json ./packages/shared/
COPY worker/package.json ./worker/
COPY worker/tsconfig.json ./worker/

RUN npm install

COPY packages/shared/src ./packages/shared/src
COPY worker/src ./worker/src

RUN npm run build --workspace=packages/shared && \
    npm run build --workspace=worker

FROM node:22-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production

USER node

COPY --chown=node:node --from=builder /app/package.json /app/package-lock.json ./
COPY --chown=node:node --from=builder /app/packages/shared/package.json ./packages/shared/
COPY --chown=node:node --from=builder /app/packages/shared/dist ./packages/shared/dist
COPY --chown=node:node --from=builder /app/worker/package.json ./worker/
COPY --chown=node:node --from=builder /app/worker/dist ./worker/dist

RUN npm install --omit=dev

CMD ["node", "worker/dist/index.js"]
